---
import { Building2, Home, Warehouse, Landmark } from "@lucide/astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { sectors } from "@/data/sectors";

const icons = [Home, Landmark, Building2, Warehouse];
---

<section class="section-hk bg-hk-surface">
  <div class="container-hk">
    <SectionHeader
      eyebrow="Sectores"
      title="Diseño según el riesgo real de cada lugar."
      description="No todos los espacios necesitan la misma solucion. El valor esta en cubrir los puntos correctos sin sobredimensionar el proyecto."
      align="center"
    />
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        sectors.map((sector, index) => {
          const Icon = icons[index];
          return (
            <article class="surface-panel p-6">
              <span class="flex size-12 items-center justify-center rounded-lg bg-hk-primary text-white">
                <Icon size={24} aria-hidden="true" />
              </span>
              <h3 class="heading-hk mt-5 text-xl">{sector.title}</h3>
              <p class="mt-3 text-sm text-hk-muted">{sector.summary}</p>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

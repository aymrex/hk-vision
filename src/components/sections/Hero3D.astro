---
import Button from "@/components/ui/Button.astro";
import { whatsappHref } from "@/data/contact";
---

<section class="relative overflow-hidden bg-[linear-gradient(135deg,#ffffff_0%,#f6fafd_58%,#eaf6fb_100%)]">
  <div class="container-hk grid min-h-[calc(100dvh-80px)] items-center gap-10 py-14 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="relative z-10 max-w-3xl">
      <h1 class="heading-hk max-w-[13ch] text-4xl text-balance sm:text-5xl lg:text-[4rem]">
        Seguridad física y digital, con criterio técnico.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-hk-muted md:text-xl">
        Instalación de cámaras, CCTV, ciberseguridad y desarrollo de software para casas, condominios, empresas y bodegas.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={whatsappHref} label="Cotizar por WhatsApp" external />
        <Button href="/servicios" label="Ver servicios" variant="secondary" />
      </div>
      <dl class="mt-10 grid max-w-2xl grid-cols-3 gap-3">
        <div class="rounded-lg border border-hk-border bg-white/75 p-2 sm:p-4">
          <dt class="text-xs text-hk-muted sm:text-sm">Zona</dt>
          <dd class="whitespace-nowrap font-heading text-sm font-semibold text-hk-primary sm:text-lg">Santiago</dd>
        </div>
        <div class="rounded-lg border border-hk-border bg-white/75 p-2 sm:p-4">
          <dt class="text-xs text-hk-muted sm:text-sm">Servicios</dt>
          <dd class="whitespace-nowrap font-heading text-sm font-semibold text-hk-primary sm:text-lg">4 áreas</dd>
        </div>
        <div class="rounded-lg border border-hk-border bg-white/75 p-2 sm:p-4">
          <dt class="text-xs text-hk-muted sm:text-sm">Enfoque</dt>
          <dd class="whitespace-nowrap font-heading text-sm font-semibold text-hk-primary sm:text-lg">Integral</dd>
        </div>
      </dl>
    </div>

    <div data-scene-wrap class="relative min-h-[360px] overflow-hidden rounded-lg lg:min-h-[520px]">
      <div class="absolute inset-0 rounded-lg border border-hk-border bg-white/58 shadow-[0_30px_90px_rgba(27,79,114,0.13)]"></div>
      <canvas id="security-scene" class="absolute inset-0 h-full w-full" aria-label="Animación 3D abstracta de seguridad digital"></canvas>
      <div class="pointer-events-none absolute inset-x-8 bottom-8 rounded-lg border border-hk-border bg-white/82 p-5 backdrop-blur">
        <p class="font-heading text-sm font-semibold text-hk-primary">Cobertura, monitoreo y continuidad</p>
        <p class="mt-1 text-sm text-hk-muted">Una visualización abstracta de red protegida y puntos críticos cubiertos.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("#security-scene");
  if (canvas) {
    const startScene = async () => {
      try {
        const { initSecurityScene } = await import("../../assets/3d/security-scene");
        initSecurityScene(canvas);
      } catch {
        canvas.closest("[data-scene-wrap]")?.classList.add("is-reduced-motion");
      }
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            startScene();
          }
        },
        { rootMargin: "160px" },
      );
      observer.observe(canvas);
    } else {
      startScene();
    }
  }
</script>

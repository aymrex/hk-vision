---
type Props = {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
};

const { eyebrow, title, description, align = "left" } = Astro.props;
---

<div class:list={["max-w-3xl", align === "center" && "mx-auto text-center"]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="heading-hk mt-3 text-3xl md:text-5xl text-balance">{title}</h2>
  {
    description && (
      <p class="mt-5 text-lg text-hk-muted md:text-xl">{description}</p>
    )
  }
</div>

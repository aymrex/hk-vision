---
import { ArrowUpRight, Mail, MapPin, Phone, MessageCircle } from "@lucide/astro";
import { contact, whatsappHref } from "@/data/contact";

const items = [
  {
    icon: MessageCircle,
    title: "WhatsApp",
    description: "Para consultas y cotizaciones directas.",
    text: "Abre una conversación con HK Vision.",
    href: whatsappHref,
    label: "Escribir por WhatsApp",
  },
  {
    icon: Phone,
    title: "Teléfono",
    description: "Si prefieres resolver tus dudas por una llamada.",
    text: contact.phoneDisplay,
    href: `tel:${contact.phoneHref}`,
    label: "Llamar ahora",
  },
  {
    icon: Mail,
    title: "Correo",
    description: "Para compartir los detalles de tu proyecto por escrito.",
    text: contact.email,
    href: `mailto:${contact.email}`,
    label: "Enviar correo",
  },
  {
    icon: MapPin,
    title: "Zona",
    description: "Soluciones para casas, condominios, empresas y bodegas.",
    text: contact.city,
    href: "/sectores",
    label: "Ver sectores",
  },
];
---

<div class="grid grid-cols-1 gap-4 min-[360px]:grid-cols-2">
  {
    items.map(({ icon: Icon, title, description, text, href, label }) => (
      <a class="surface-panel group flex min-h-52 flex-col items-center p-5 text-center transition duration-200 hover:-translate-y-1 hover:border-hk-accent" href={href}>
        <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-hk-surface text-hk-primary-mid">
          <Icon size={23} aria-hidden="true" />
        </span>
        <span class="mt-4 block w-full font-heading text-lg font-semibold text-hk-primary">{title}</span>
        <span class="mt-2 block min-h-10 text-sm leading-relaxed text-hk-muted">{description}</span>
        <span class="mt-2 block w-full break-words font-heading text-sm font-semibold text-hk-text">{text}</span>
        <span class="mt-auto inline-flex items-center justify-center gap-1 pt-4 text-sm font-semibold text-hk-primary-mid">
          {label}
          <ArrowUpRight size={16} aria-hidden="true" />
        </span>
      </a>
    ))
  }
</div>

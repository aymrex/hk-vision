---
import { ArrowRight } from "@lucide/astro";

type Props = {
  href: string;
  label: string;
  variant?: "primary" | "secondary" | "ghost";
  external?: boolean;
};

const { href, label, variant = "primary", external = false } = Astro.props;

const variants = {
  primary:
    "bg-hk-primary-mid text-white on-primary border-hk-primary-mid hover:bg-hk-primary hover:border-hk-primary",
  secondary:
    "bg-white text-hk-primary border-hk-border hover:border-hk-primary-mid hover:text-hk-primary-mid",
  ghost:
    "bg-transparent text-hk-primary border-transparent hover:bg-hk-surface",
};
---

<a
  class:list={[
    "inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border px-5 py-3 font-heading text-sm font-semibold transition duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-hk-accent",
    variants[variant],
  ]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
>
  <span>{label}</span>
  <ArrowRight size={18} strokeWidth={2} aria-hidden="true" />
</a>

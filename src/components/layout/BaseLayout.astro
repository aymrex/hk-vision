---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingWhatsApp from "@/components/contact/FloatingWhatsApp.astro";
import "@/styles/globals.css";
import { seo } from "@/data/seo";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = seo.defaultTitle,
  description = seo.defaultDescription,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://hkvision.cl").toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>

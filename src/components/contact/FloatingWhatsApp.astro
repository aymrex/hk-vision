---
import { MessageCircle } from "@lucide/astro";
import { whatsappHref } from "@/data/contact";
---

<a
  class="fixed bottom-4 right-4 z-50 inline-flex size-14 items-center justify-center rounded-full bg-hk-primary-mid text-white on-primary shadow-2xl transition hover:-translate-y-1 hover:bg-hk-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-hk-accent sm:bottom-5 sm:right-5"
  href={whatsappHref}
  target="_blank"
  rel="noreferrer"
  aria-label="Contactar a HK Vision por WhatsApp"
>
  <MessageCircle size={26} aria-hidden="true" />
</a>

---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import ContactCTA from "@/components/sections/ContactCTA.astro";
import BackLink from "@/components/ui/BackLink.astro";
import Button from "@/components/ui/Button.astro";
import { seo } from "@/data/seo";
import { getService } from "@/data/services";
import { whatsappHref } from "@/data/contact";

const service = getService("cctv");
---

<BaseLayout title={seo.pages.cctv.title} description={seo.pages.cctv.description}>
  <section class="section-hk bg-hk-surface">
    <div class="container-hk grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <BackLink fallback="/servicios" />
        <p class="eyebrow">CCTV en Santiago</p>
        <h1 class="heading-hk mt-4 text-4xl md:text-6xl">Instalación de cámaras de seguridad y CCTV.</h1>
        <p class="mt-6 text-lg text-hk-muted">{service?.description}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={whatsappHref} label="Cotizar CCTV" external />
          <Button href="/contacto" label="Formulario" variant="secondary" />
        </div>
      </div>
      <div class="surface-panel p-7">
        <h2 class="heading-hk text-2xl">Qué se considera</h2>
        <ul class="mt-6 grid gap-4">
          {service?.benefits.map((benefit) => <li class="rounded-lg bg-hk-surface p-4 text-hk-text">{benefit}</li>)}
        </ul>
      </div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>

---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import ContactCTA from "@/components/sections/ContactCTA.astro";
import BackLink from "@/components/ui/BackLink.astro";
import ServiceCard from "@/components/ui/ServiceCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { seo } from "@/data/seo";
import { services } from "@/data/services";
---

<BaseLayout title={seo.pages.servicios.title} description={seo.pages.servicios.description}>
  <section class="section-hk bg-hk-surface">
    <div class="container-hk">
      <BackLink fallback="/" />
      <SectionHeader
        eyebrow="Servicios"
        title="Seguridad, tecnología y software con una mirada integral."
        description="HK Vision combina soluciones físicas, digitales y operativas para resolver necesidades reales de protección, continuidad y gestión."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>

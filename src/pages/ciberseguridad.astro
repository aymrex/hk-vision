---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import ContactCTA from "@/components/sections/ContactCTA.astro";
import BackLink from "@/components/ui/BackLink.astro";
import Button from "@/components/ui/Button.astro";
import { whatsappHref } from "@/data/contact";
import { seo } from "@/data/seo";
import { getService } from "@/data/services";

const service = getService("ciberseguridad");
---

<BaseLayout title={seo.pages.ciberseguridad.title} description={seo.pages.ciberseguridad.description}>
  <section class="section-hk bg-white">
    <div class="container-hk grid gap-10 lg:grid-cols-[1fr_0.9fr] lg:items-center">
      <div>
        <BackLink fallback="/servicios" />
        <p class="eyebrow">Ciberseguridad</p>
        <h1 class="heading-hk mt-4 text-4xl md:text-6xl">Protección digital sin complicar la operación.</h1>
        <p class="mt-6 text-lg text-hk-muted">{service?.description}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={whatsappHref} label="Consultar protección" external />
          <Button href="/servicios" label="Ver servicios" variant="secondary" />
        </div>
      </div>
      <div class="surface-panel p-7">
        <h2 class="heading-hk text-2xl">Foco inicial</h2>
        <ul class="mt-6 grid gap-4">
          {service?.benefits.map((benefit) => <li class="rounded-lg bg-hk-surface p-4 text-hk-text">{benefit}</li>)}
        </ul>
      </div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>

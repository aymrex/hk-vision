---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import BackLink from "@/components/ui/BackLink.astro";
import Button from "@/components/ui/Button.astro";
---

<BaseLayout title="Pagina no encontrada | HK Vision" description="La pagina solicitada no existe.">
  <section class="section-hk bg-hk-surface">
    <div class="container-hk max-w-2xl text-center">
      <div class="mb-8 flex justify-center">
        <BackLink fallback="/" />
      </div>
      <p class="eyebrow">404</p>
      <h1 class="heading-hk mt-4 text-4xl md:text-6xl">Pagina no encontrada.</h1>
      <p class="mt-5 text-lg text-hk-muted">La ruta que buscas no existe o fue movida.</p>
      <div class="mt-8">
        <Button href="/" label="Volver al inicio" />
      </div>
    </div>
  </section>
</BaseLayout>
